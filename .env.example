# =============================================================================
# CertiSafe — Variables de entorno del backend
# Copie este archivo como referencia (.env.example es documentación; Spring Boot
# no lo carga solo: exporte las variables en su terminal o configúrelas en su IDE).
# Los valores mostrados son los de desarrollo local. NO use estos valores en producción.
# =============================================================================

# --- Base de datos PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=Certisafe
DB_USER=postgres
DB_PASSWORD=postgres

# --- Seguridad JWT (HS256, el secreto debe tener 32 caracteres o más) ---
JWT_SECRET=cambie-este-secreto-por-uno-seguro-de-32-caracteres-minimo
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# --- Servidor y CORS ---
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- Usuario ADMIN inicial (solo se crea si la tabla users está vacía) ---
BOOTSTRAP_ENABLED=true
BOOTSTRAP_ADMIN_EMAIL=admin@certisafe.local
BOOTSTRAP_ADMIN_PASSWORD=Admin123*
BOOTSTRAP_ADMIN_FIRST_NAME=Administrador
BOOTSTRAP_ADMIN_LAST_NAME=CertiSafe

# --- Carga masiva (RF-017 / RF-018, RNF-009) ---
IMPORT_MAX_ROWS=5000
IMPORT_BATCH_SIZE=500

# --- Recuperación de contraseña (RF-023) ---
# Sin MAIL_SMTP_HOST no se intenta SMTP: el enlace de recuperación se escribe
# en el log del backend, lo que permite probar el flujo sin servidor de correo.
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=587
MAIL_SMTP_USERNAME=
MAIL_SMTP_PASSWORD=
MAIL_FROM=no-responder@certisafe.local
FRONTEND_URL=http://localhost:4200
RECOVERY_TOKEN_TTL_MINUTES=15
